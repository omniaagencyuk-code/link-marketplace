# ---------------------------------------------------------------------------
# Press Parrot environment variables
# Copy this file to `.env.local` and fill in the values.
# The app runs fully on mock data when these are left empty.
# ---------------------------------------------------------------------------

# Public site URL - used for canonical URLs, sitemap.xml and robots.txt
  Production: https://www.pressparrot.com|  Production: https://www.pressparrot.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source for the service layer: "mock" (default) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# Mock auth (development only). When enabled the app pretends a user is
# signed in so dashboard/admin can be developed without Supabase Auth.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true

# ---------------------------------------------------------------------------
# Supabase (not required yet - see supabase/README.md)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
