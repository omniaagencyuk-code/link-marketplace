# ---------------------------------------------------------------------------
# Press Parrot environment variables
# Copy this file to `.env.local` and fill in the values.
# The app runs fully on mock data when these are left empty.
# ---------------------------------------------------------------------------

# Public site URL - used for canonical URLs, sitemap.xml and robots.txt
# Local: http://localhost:3000   |   Production: https://pressparrot.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source for the service layer: "mock" (default) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Customer sessions
#
# The marketplace inventory is account-only, so customer sign-in issues a
# signed session cookie that the server verifies on every protected request.
# Credentials themselves are still mocked (any email signs in) until Supabase
# Auth is connected - the session is what does the protecting.
#
# Generate with: openssl rand -base64 32
# Falls back to ADMIN_SESSION_SECRET when unset, and to a fixed development
# value outside production. In production with neither set, sign-in fails
# closed with a clear message rather than issuing unprotected sessions.
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase - see supabase/README.md
#
# Set NEXT_PUBLIC_DATA_SOURCE=supabase above once these are filled in. With the
# switch on but the keys missing, the app falls back to the mock store rather
# than erroring on every page.
#
# The public values are under Project Settings -> API Keys, or behind the
# Connect button at the top of the dashboard. They are designed to ship in the
# browser; row level security is what protects the data behind them.
#
# Supabase renamed these. Newer projects issue "sb_publishable_..." and
# "sb_secret_..."; older ones issue JWTs starting "eyJ...". Either naming works
# - set whichever pair your dashboard shows and leave the other blank.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Newer projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row level security entirely, so it is used only by
# the seed script, the bulk importer and the redacted public preview. Never
# expose it to the browser, never commit it, and never paste it into a chat or
# an issue.
#
# Newer projects:
SUPABASE_SECRET_KEY=
# Older projects:
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin area (/admin)
#
# Server-side gate for the admin section. All three are required: with any of
# them missing the admin area locks itself rather than opening up.
# Never prefix these with NEXT_PUBLIC_ - that would ship them to the browser.
# ---------------------------------------------------------------------------

# Comma separated addresses allowed to sign in.
ADMIN_EMAILS=james@omniaagency.co,andrew@omniaagency.co

# Shared password for the admin sign-in form. Use a long random value.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Live chat
#
# "built-in" (default) shows the in-house panel, which hands the message to
# email. Set to "crisp" or "tawk" once an account exists, and fill in the ids
# below. "off" hides the launcher entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_PROVIDER=built-in

# Crisp: Settings -> Setup instructions -> Website ID
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Tawk.to: the two ids in your widget's embed URL
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Reading publisher replies (admin > Publisher inbox). Extraction stays off
# until it is switched on in the admin, so this can be absent.
ANTHROPIC_API_KEY=
# Only needed when the key above belongs to the organisation rather than to a
# workspace. A workspace-scoped key carries this already. Starts wrkspc_.
ANTHROPIC_WORKSPACE_ID=
